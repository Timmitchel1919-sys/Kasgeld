rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && exists(memberPath(groupId, request.auth.uid));
    }

    function isAdmin(groupId) {
      return isMember(groupId)
        && get(memberPath(groupId, request.auth.uid)).data.role in ['owner', 'admin'];
    }

    function isOwnerAfter(groupId) {
      return verified()
        && getAfter(groupPath(groupId)).data.ownerId == request.auth.uid;
    }

    function validUser(uid) {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'displayName', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.uid == uid
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.displayName is string
      && request.resource.data.displayName.size() >= 2
      && request.resource.data.displayName.size() <= 80;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if verified() && isSelf(uid) && validUser(uid);
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isMember(groupId);
      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'currency', 'notificationsEnabled', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.currency == 'EUR'
        && request.resource.data.notificationsEnabled is bool;
      allow update: if verified() && isAdmin(groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'notificationsEnabled', 'updatedAt'
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.currency == resource.data.currency;
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(groupId);
        allow create: if verified()
          && request.resource.data.keys().hasOnly([
            'uid', 'email', 'displayName', 'role', 'status', 'joinedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.role in ['owner', 'admin', 'member']
          && request.resource.data.status == 'active'
          && ((uid == request.auth.uid && isOwnerAfter(groupId)) || isAdmin(groupId));
        allow update: if verified() && isAdmin(groupId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role in ['owner', 'admin', 'member']
          && request.resource.data.status in ['active', 'inactive'];
        allow delete: if false;
      }

      match /participants/{participantId} {
        allow read: if isMember(groupId);
        allow create: if verified() && isMember(groupId)
          && request.resource.data.keys().hasOnly([
            'name', 'phone', 'status', 'assignedMonth', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.phone is string
          && request.resource.data.status == 'registered'
          && request.resource.data.assignedMonth == null;
        allow update: if verified() && isMember(groupId)
          && (resource.data.createdBy == request.auth.uid || isAdmin(groupId))
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.assignedMonth == resource.data.assignedMonth;
        allow delete: if false;
      }

      match /months/{monthId} {
        allow read: if isMember(groupId);
        // Alleen een vertrouwde Cloud Function mag een maand toewijzen.
        allow write: if false;
      }

      match /activities/{activityId} {
        allow read: if isMember(groupId);
        // Auditregels worden uitsluitend server-side geschreven.
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
