{
  "name": "kasgeld-applicatie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src/App.test.tsx src/auth/AuthScreen.test.tsx src/landing/LandingPage.test.tsx --no-fsModuleCache --pool=forks --no-file-parallelism --maxWorkers=1",
    "test:rules": "vitest run src/firebase/firestore.rules.test.ts --no-fsModuleCache --pool=forks --no-file-parallelism --maxWorkers=1",
    "test:rules:emulator": "firebase emulators:exec --project demo-kasgeld --only firestore \"npm run test:rules\"",
    "test:functions": "npm --prefix functions test",
    "build:functions": "npm --prefix functions run build",
    "check": "npm test && npm run test:functions && npm run build && npm run build:functions"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
