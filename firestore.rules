rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function isMember(groupId) {
      return signedIn()
        && exists(memberPath(groupId, request.auth.uid))
        && get(memberPath(groupId, request.auth.uid)).data.status == 'active';
    }

    function isAdmin(groupId) {
      return isMember(groupId)
        && get(memberPath(groupId, request.auth.uid)).data.role in ['owner', 'admin'];
    }

    function validUser(uid) {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'displayName', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.uid == uid
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.displayName is string
      && request.resource.data.displayName.size() >= 2
      && request.resource.data.displayName.size() <= 80;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if verified() && isSelf(uid) && validUser(uid);
      allow delete: if false;
    }

    match /userGroups/{uid}/groups/{groupId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /invitationCodes/{codeHash} {
      allow read, write: if false;
    }

    match /groups/{groupId} {
      allow read: if isMember(groupId);
      // Groepen en instellingen worden uitsluitend via vertrouwde Cloud Functions beheerd.
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(groupId);
        allow write: if false;
      }

      match /participants/{participantId} {
        allow read: if isMember(groupId);
        allow write: if false;

        match /pushTokens/{tokenId} {
          allow read, write: if false;
        }
      }

      match /months/{monthId} {
        allow read: if isMember(groupId);
        // Alleen een vertrouwde Cloud Function mag een maand toewijzen.
        allow write: if false;
      }

      match /activities/{activityId} {
        allow read: if isAdmin(groupId);
        // Auditregels worden uitsluitend server-side geschreven.
        allow write: if false;
      }

      match /invitations/{invitationId} {
        allow read: if isAdmin(groupId);
        allow write: if false;
      }

      match /notificationOutbox/{messageId} {
        allow read: if isAdmin(groupId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
